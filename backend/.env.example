# Never commit real values. Use Render secrets or local PowerShell environment variables.
SPRING_PROFILES_ACTIVE=prod
JDBC_DATABASE_URL=jdbc:postgresql://HOST:5432/DB?sslmode=require
JDBC_DATABASE_USERNAME=YOUR_USERNAME
JDBC_DATABASE_PASSWORD=SET_IN_SECRET_MANAGER
ZRAIN_JWT_SECRET_BASE64=SET_RANDOM_32_BYTE_BASE64_SECRET
ZRAIN_ADMIN_EMAIL=YOUR_PRIVATE_ADMIN_EMAIL
ZRAIN_ADMIN_PASSWORD=SET_LONG_UNIQUE_PRIVATE_PASSWORD
ZRAIN_ALLOWED_ORIGIN=https://zrain.web.app

# Cloudflare Worker URL is the origin only (without /api/catalog)
ZRAIN_CATALOG_WORKER_URL=https://YOUR_WORKER_SUBDOMAIN.workers.dev
# Use the exact same 32+ character secret in Render and Wrangler
ZRAIN_CATALOG_PUBLISH_KEY=SET_IN_RENDER_AND_WRANGLER
