{
  "name": "zrain-ecosystem",
  "version": "10.0.0",
  "private": true,
  "type": "module",
  "description": "Unified Zrain Ecosystem",
  "scripts": {
    "ui:sync": "node scripts/sync-zrain-ui.mjs",
    "ui:check": "node scripts/sync-zrain-ui.mjs --check",
    "build": "node scripts/build-unified.mjs --rebuild-runtime",
    "test": "node --test tests/*.test.mjs && npm --prefix tool-runtime test && npm --prefix catalog-worker test",
    "test:release": "npm run persona:check && npm run ui:check && npm run build && npm run test:legacy && npm test",
    "persona:check": "node scripts/check-persona-release.mjs --strict",
    "test:legacy": "node --test test/*.js"
  },
  "dependencies": {
    "@zrain/ui": "github:zrain03/zrain-ui#a109401fa591afa9f66479fa8d86f1ed1679d70b"
  },
  "engines": {
    "node": ">=20"
  },
  "zrainUi": {
    "publicDir": "public"
  }
}
